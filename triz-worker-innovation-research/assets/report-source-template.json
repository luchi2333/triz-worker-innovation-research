            {
              "header": "候选创新",
              "field": "innovation_attribution/candidate_innovation"
            },
            {
              "header": "创新边界",
              "field": "innovation_attribution/innovation_boundary"
            },
            {
              "header": "待验证项",
              "field": "innovation_attribution/validation_needed"
            }
          ]
        },
        {
          "type": "table",
          "table_ref": "/routes",
          "columns": [
            {
              "header": "路线",
              "field": "id"
            },
            {
              "header": "提升状态",
