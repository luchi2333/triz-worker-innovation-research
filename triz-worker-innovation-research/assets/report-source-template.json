      "blocks": [
        {
          "type": "paragraph",
          "text_template": "经济效益状态：{{/models_and_tests/benefit_assessment/economic/status}}；公式/计算框架：{{/models_and_tests/benefit_assessment/economic/formula}}；情景计划：{{/models_and_tests/benefit_assessment/economic/scenario_plan}}；说明：{{/models_and_tests/benefit_assessment/economic/rationale}}。"
