              "join": "、"
            },
            {
              "header": "原因",
              "field": "causes",
              "join": "；"
            },
            {
              "header": "后果",
              "field": "consequences",
              "join": "；"
            },
            {
              "header": "控制",
              "field": "controls",
              "join": "；"
            },
            {
              "header": "残余风险",
