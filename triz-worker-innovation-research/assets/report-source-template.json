        {
          "type": "table",
          "table_ref": "/contradictions",
          "columns": [
            {
              "header": "矛盾",
              "field": "id"
            },
            {
              "header": "改善方向",
              "field": "useful_result"
            },
            {
              "header": "恶化结果",
              "field": "worsened_result"
            },
            {
              "header": "因果依据",
              "field": "causality_basis"
            },
            {
              "header": "TRIZ 资格",
              "field": "eligibility"
            }
          ]
        },
        {
          "type": "table",
          "table_ref": "/mechanisms",
          "columns": [
            {
              "header": "机理",
              "field": "id"
            },
            {
              "header": "方法",
              "field": "method"
            },
            {
              "header": "输入",
              "field": "input"
            },
            {
              "header": "作用路径",
              "field": "action_path",
              "join": " → "
            },
            {
              "header": "输出",
              "field": "output"
            },
            {
              "header": "反证",
              "field": "falsification"
            }
          ]
        }
      ]
    },
    {
