            {
              "header": "来源",
              "field": "source_ids",
              "join": "、",
              "empty_text": "无纳入来源"
            },
            {
              "header": "说明",
              "field": "rationale"
            }
          ]
        },
        {
          "type": "table",
          "table_ref": "/queries",
          "columns": [
            {
              "header": "查询ID",
              "field": "id"
            },
            {
              "header": "轨道",
              "field": "track"
            },
            {
              "header": "原始检索式",
              "field": "query"
            },
            {
              "header": "状态",
              "field": "status"
            },
            {
              "header": "纳入来源",
              "field": "included_source_ids",
              "join": "、",
              "empty_text": "无"
            }
          ]
        }
      ]
    },
    {
